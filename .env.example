# NVIDIA_API_KEY: Get a free key at https://build.nvidia.com
# Model used: nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_API_KEY="your_nvidia_api_key_here"

# GROQ_API_KEY: used if NVIDIA_API_KEY is not set
# Model used: groq/llama-3.1-8b-instant
GROQ_API_KEY="your_groq_api_key_here"

APP_URL="http://localhost:3000"

# JWT_SECRET: used to sign restaurant account auth tokens. Set a long random value.
JWT_SECRET="replace_with_a_long_random_string"
